class MonitorInfo:
    """Data class for monitor information"""
    
    def __init__(self, index: int, name: str, width: int, height: int, 
                 x: int, y: int, is_primary: bool = False,
                 work_width: Optional[int] = None, 
                 work_height: Optional[int] = None,
                 work_x: Optional[int] = None,
                 work_y: Optional[int] = None):
        self.index = index
        self.name = name
        self.width = width
        self.height = height
        self.x = x
        self.y = y
        self.is_primary = is_primary
        self.work_width = work_width or width
        self.work_height = work_height or height
        self.work_x = work_x or x
        self.work_y = work_y or y
    
    def to_dict(self) -> Dict:
        """Convert to dictionary"""
        return {
            'index': self.index,
            'name': self.name,
            'width': self.width,
            'height': self.height,
            'x': self.x,
            'y': self.y,
            'is_primary': self.is_primary,
            'work_width': self.work_width,
            'work_height': self.work_height,
            'work_x': self.work_x,
            'work_y': self.work_y
        }
    
    @classmethod
    def from_dict(cls, data: Dict) -> 'MonitorInfo':
        """Create from dictionary"""
        return cls(
            index=data['index'],
            name=data['name'],
            width=data['width'],
            height=data['height'],
            x=data['x'],
            y=data['y'],
            is_primary=data.get('is_primary', False),
            work_width=data.get('work_width'),
            work_height=data.get('work_height'),
            work_x=data.get('work_x'),
            work_y=data.get('work_y')
        )
    
    def __repr__(self) -> str:
        return f"MonitorInfo({self.index}: {self.name} {self.width}x{self.height} at ({self.x}, {self.y}))"


class MultiMonitorManager:
    """
    Universal multi-monitor manager with accurate position detection
    
    Features:
    - Cross-platform (Windows, Linux, macOS)
    - Multi-level detection (Win32 API → PyQt6 → screeninfo → Tkinter)
    - Auto-save configuration
    - Launch applications on specific monitors
    - Singleton pattern for global access
    """
    
    _instance = None
    _lock = threading.Lock()
    
    def __new__(cls, *args, **kwargs):
        with cls._lock:
            if cls._instance is None:
                cls._instance = super().__new__(cls)
            return cls._instance
    
    def __init__(self, config_dir: Optional[str] = None):
        """
        Initialize the multi-monitor manager
        
        Args:
            config_dir: Custom configuration directory (optional)
        """
        if hasattr(self, '_initialized') and self._initialized:
            return
        
        self._initialized = True
        self.monitors: List[MonitorInfo] = []
        self.processes: Dict[int, subprocess.Popen] = {}
        self.is_running = True
        
        self._init_paths(config_dir)
        self._detect_monitors_accurate()
        
        logger.info(f"Initialized. Found {len(self.monitors)} monitor(s)")
        for i, mon in enumerate(self.monitors):
            logger.info(f"  {i+1}. {mon.name} ({mon.width}x{mon.height}) at ({mon.x}, {mon.y})")
    
    def _init_paths(self, config_dir: Optional[str] = None):
        """Initialize file paths"""
        try:
            if config_dir:
                base_path = config_dir
            else:
                base_path = os.path.dirname(os.path.abspath(__file__))
            
            self.config_path = os.path.join(base_path, "config")
            self.temp_dir = os.path.join(base_path, "temp")
            
            os.makedirs(self.config_path, exist_ok=True)
            os.makedirs(self.temp_dir, exist_ok=True)
            
            self.monitor_config_path = os.path.join(self.config_path, "monitors.json")
        except Exception as e:
            logger.error(f"Failed to initialize paths: {e}")
            # Fallback to current directory
            self.config_path = os.path.join(os.getcwd(), "config")
            self.temp_dir = os.path.join(os.getcwd(), "temp")
            self.monitor_config_path = os.path.join(self.config_path, "monitors.json")
            os.makedirs(self.config_path, exist_ok=True)
            os.makedirs(self.temp_dir, exist_ok=True)
    
    def _detect_monitors_accurate(self):
        """Detect monitors using multiple methods"""
        self.monitors = []
        
        # Method 1: Win32 API (Windows only)
        if WIN32_AVAILABLE:
            try:
                monitors = self._get_monitors_win32()
                if monitors:
                    self.monitors = monitors
                    logger.info(f"Detected via Win32 API: {len(monitors)} monitor(s)")
                    self._save_monitor_config()
                    return
            except Exception as e:
                logger.warning(f"Win32 API detection failed: {e}")
        
        # Method 2: PyQt6
        if PYQT_AVAILABLE and not self.monitors:
            try:
                monitors = self._get_monitors_pyqt()
                if monitors:
                    self.monitors = monitors
                    logger.info(f"Detected via PyQt6: {len(monitors)} monitor(s)")
                    self._save_monitor_config()
                    return
            except Exception as e:
                logger.warning(f"PyQt6 detection failed: {e}")
        
        # Method 3: screeninfo
        if SCREENINFO_AVAILABLE and not self.monitors:
            try:
                for i, m in enumerate(get_monitors()):
                    self.monitors.append(MonitorInfo(
                        index=i,
                        name=m.name or f"Monitor {i+1}",
                        width=m.width,
                        height=m.height,
                        x=m.x,
                        y=m.y,
                        is_primary=m.is_primary
                    ))
                logger.info(f"Detected via screeninfo: {len(self.monitors)} monitor(s)")
                self._save_monitor_config()
                return
            except Exception as e:
                logger.warning(f"screeninfo detection failed: {e}")
        
        # Method 4: Tkinter (fallback)
        if not self.monitors:
            try:
                import tkinter as tk
                root = tk.Tk()
                root.withdraw()
                
                self.monitors.append(MonitorInfo(
                    index=0,
                    name="Primary Monitor",
                    width=root.winfo_screenwidth(),
                    height=root.winfo_screenheight(),
                    x=0,
                    y=0,
                    is_primary=True
                ))
                
                # Add secondary monitor if dual-screen setup
                screen_width = root.winfo_screenwidth()
                self.monitors.append(MonitorInfo(
                    index=1,
                    name="Secondary Monitor",
                    width=1920,
                    height=1080,
                    x=screen_width,
                    y=0,
                    is_primary=False
                ))
                
                root.destroy()
                logger.info(f"Detected via Tkinter (fallback): {len(self.monitors)} monitor(s)")
            except Exception as e:
                logger.warning(f"Tkinter detection failed: {e}")
        
        # Method 5: Default fallback
        if not self.monitors:
            self.monitors = [
                MonitorInfo(0, "Monitor 1", 1920, 1080, 0, 0, True),
                MonitorInfo(1, "Monitor 2", 1920, 1080, 1920, 0, False)
            ]
            logger.warning(f"Using fallback configuration: {len(self.monitors)} monitor(s)")
        
        self._save_monitor_config()
    
    def _get_monitors_win32(self) -> List[MonitorInfo]:
        """Get monitors using Windows API"""
        monitors = []
        try:
            user32 = ctypes.windll.user32
            
            MONITORENUMPROC = ctypes.WINFUNCTYPE(
                ctypes.c_int,
                ctypes.c_ulong,
                ctypes.c_ulong,
                ctypes.POINTER(wintypes.RECT),
                ctypes.c_double
            )
            
            monitors_list = []
            
            def callback(hMonitor, hdcMonitor, lprcMonitor, dwData):
                class MONITORINFOEXW(ctypes.Structure):
                    _fields_ = [
                        ("cbSize", wintypes.DWORD),
                        ("rcMonitor", wintypes.RECT),
                        ("rcWork", wintypes.RECT),
                        ("dwFlags", wintypes.DWORD),
                        ("szDevice", wintypes.WCHAR * 32)
                    ]
                
                monitor_info = MONITORINFOEXW()
                monitor_info.cbSize = ctypes.sizeof(MONITORINFOEXW)
                
                if user32.GetMonitorInfoW(hMonitor, ctypes.byref(monitor_info)):
                    rc = monitor_info.rcMonitor
                    rc_work = monitor_info.rcWork
                    is_primary = bool(monitor_info.dwFlags & 0x00000001)
                    
                    monitors_list.append({
                        'name': monitor_info.szDevice,
                        'x': rc.left,
                        'y': rc.top,
                        'width': rc.right - rc.left,
                        'height': rc.bottom - rc.top,
                        'work_x': rc_work.left,
                        'work_y': rc_work.top,
                        'work_width': rc_work.right - rc_work.left,
                        'work_height': rc_work.bottom - rc_work.top,
                        'is_primary': is_primary
                    })
                return 1
            
            callback_func = MONITORENUMPROC(callback)
            hdc = user32.GetDC(0)
            
            if user32.EnumDisplayMonitors(hdc, None, callback_func, 0):
                monitors_list.sort(key=lambda m: m['x'])
                
                for i, mon in enumerate(monitors_list):
                    monitors.append(MonitorInfo(
                        index=i,
                        name=mon['name'],
                        width=mon['width'],
                        height=mon['height'],
                        x=mon['x'],
                        y=mon['y'],
                        is_primary=mon['is_primary'],
                        work_width=mon['work_width'],
                        work_height=mon['work_height'],
                        work_x=mon['work_x'],
                        work_y=mon['work_y']
                    ))
                
                user32.ReleaseDC(0, hdc)
                
        except Exception as e:
            logger.error(f"Win32 API error: {e}")
        
        return monitors
    
    def _get_monitors_pyqt(self) -> List[MonitorInfo]:
        """Get monitors using PyQt6"""
        monitors = []
        try:
            app = QApplication.instance()
            if not app:
                app = QApplication(sys.argv)
            
            screens = QGuiApplication.screens()
            
            for i, screen in enumerate(screens):
                geom = screen.geometry()
                available_geom = screen.availableGeometry()
                
                monitors.append(MonitorInfo(
                    index=i,
                    name=screen.name(),
                    width=geom.width(),
                    height=geom.height(),
                    x=geom.x(),
                    y=geom.y(),
                    is_primary=(screen == QGuiApplication.primaryScreen()),
                    work_width=available_geom.width(),
                    work_height=available_geom.height(),
                    work_x=available_geom.x(),
                    work_y=available_geom.y()
                ))
            
            if not QApplication.instance():
                app.quit()
                
        except Exception as e:
            logger.error(f"PyQt6 detection error: {e}")
        
        return monitors
    
    def _save_monitor_config(self):
        """Save monitor configuration to file"""
        try:
            config = {
                'monitors': [m.to_dict() for m in self.monitors],
                'saved_at': datetime.now().isoformat()
            }
            with open(self.monitor_config_path, 'w', encoding='utf-8') as f:
                json.dump(config, f, indent=2, ensure_ascii=False)
            logger.debug(f"Configuration saved to {self.monitor_config_path}")
        except Exception as e:
            logger.warning(f"Failed to save configuration: {e}")
    
    def load_monitor_config(self) -> bool:
        """Load monitor configuration from file"""
        try:
            if os.path.exists(self.monitor_config_path):
                with open(self.monitor_config_path, 'r', encoding='utf-8') as f:
                    config = json.load(f)
                
                self.monitors = [MonitorInfo.from_dict(m) for m in config['monitors']]
                logger.info(f"Loaded configuration: {len(self.monitors)} monitor(s)")
                return True
        except Exception as e:
            logger.warning(f"Failed to load configuration: {e}")
        return False
    
    def launch_on_monitor(self, monitor_index: int, script_path: str, 
                         args: Optional[List[str]] = None) -> Optional[subprocess.Popen]:
        """
        Launch a script on a specific monitor
        
        Args:
            monitor_index: Index of the target monitor
            script_path: Path to the script to launch
            args: Additional arguments for the script
            
        Returns:
            Popen object or None if failed
        """
        if monitor_index >= len(self.monitors):
            logger.error(f"Monitor index {monitor_index} out of range")
            return None
        
        if monitor_index in self.processes:
            try:
                self.processes[monitor_index].kill()
            except (OSError, subprocess.SubprocessError) as exc:
                logger.warning("Could not stop previous process for monitor %s: %s", monitor_index, exc)
            del self.processes[monitor_index]
        
        monitor = self.monitors[monitor_index]
        
        # Generate environment variables for the target monitor
        env = os.environ.copy()
        env['MONITOR_INDEX'] = str(monitor_index)
        env['MONITOR_X'] = str(monitor.x)
        env['MONITOR_Y'] = str(monitor.y)
        env['MONITOR_WIDTH'] = str(monitor.width)
        env['MONITOR_HEIGHT'] = str(monitor.height)
        
        cmd = [sys.executable, script_path]
        if args:
            cmd.extend(args)
        
        try:
            process = subprocess.Popen(
                cmd,
                env=env,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                creationflags=subprocess.CREATE_NO_WINDOW if platform.system() == "Windows" and hasattr(subprocess, 'CREATE_NO_WINDOW') else 0
            )
            
            self.processes[monitor_index] = process
            logger.info(f"Launched process on monitor {monitor_index} (PID: {process.pid})")
            return process
            
        except Exception as e:
            logger.error(f"Failed to launch process: {e}")
            return None
    
    def launch_display_window(self, monitor_index: int) -> bool:
        """
        Launch a simple display window on a specific monitor
        
        Args:
            monitor_index: Index of the target monitor
            
        Returns:
            bool: True if successful
        """
        if monitor_index >= len(self.monitors):
            logger.error(f"Monitor index {monitor_index} out of range")
            return False
        
        if PYQT_AVAILABLE:
            return self._launch_pyqt_window(monitor_index)
        else:
            return self._launch_tkinter_window(monitor_index)
    
    def _launch_pyqt_window(self, monitor_index: int) -> bool:
        """Launch PyQt6 display window"""
        script_code = self._generate_pyqt_script(monitor_index)
        script_path = os.path.join(self.temp_dir, f"monitor_{monitor_index}.py")
        
        with open(script_path, 'w', encoding='utf-8') as f:
            f.write(script_code)
        
        return self.launch_on_monitor(monitor_index, script_path) is not None
    
    def _launch_tkinter_window(self, monitor_index: int) -> bool:
        """Launch Tkinter display window"""
        script_code = self._generate_tkinter_script(monitor_index)
        script_path = os.path.join(self.temp_dir, f"monitor_tk_{monitor_index}.py")
        
        with open(script_path, 'w', encoding='utf-8') as f:
            f.write(script_code)
        
        return self.launch_on_monitor(monitor_index, script_path) is not None
    
    def _generate_pyqt_script(self, monitor_index: int) -> str:
        """Generate PyQt6 display script"""
        return f'''# -*- coding: utf-8 -*-
