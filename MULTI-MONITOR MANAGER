    def get_monitor_info(self, index: Optional[int] = None) -> Optional[Union[MonitorInfo, List[MonitorInfo]]]:
        """
        Get monitor information
        
        Args:
            index: Monitor index (optional)
            
        Returns:
            MonitorInfo object, list of all monitors, or None if index is invalid
        """
        if index is not None:
            return self.monitors[index] if 0 <= index < len(self.monitors) else None
        return self.monitors.copy()
    
    def get_primary_monitor(self) -> Optional[MonitorInfo]:
        """Get the primary monitor"""
        for monitor in self.monitors:
            if monitor.is_primary:
                return monitor
        return self.monitors[0] if self.monitors else None
    
    def get_monitor_at_position(self, x: int, y: int) -> Optional[MonitorInfo]:
        """Get monitor at specific screen coordinates"""
        for monitor in self.monitors:
            if (monitor.x <= x < monitor.x + monitor.width and 
                monitor.y <= y < monitor.y + monitor.height):
                return monitor
        return None
    
    def get_total_resolution(self) -> tuple:
        """Get total desktop resolution"""
        if not self.monitors:
            return (0, 0)
        
        min_x = min(m.x for m in self.monitors)
        max_x = max(m.x + m.width for m in self.monitors)
        min_y = min(m.y for m in self.monitors)
        max_y = max(m.y + m.height for m in self.monitors)
        
        return (max_x - min_x, max_y - min_y)
    
    def show_status(self):
        """Display current status of all monitors"""
        print("\n" + "="*60)
        print("MULTI-MONITOR MANAGER STATUS")
        print("="*60)
        
        for i, mon in enumerate(self.monitors):
            status = "Active" if i in self.processes and self.processes[i].poll() is None else "Inactive"
            print(f"\n{i+1}. {mon.name} {'(PRIMARY)' if mon.is_primary else ''}")
            print(f"   Resolution: {mon.width}×{mon.height}")
            print(f"   Position: ({mon.x}, {mon.y})")
            print(f"   Status: {status}")
        
        print("="*60 + "\n")
    
    def refresh(self):
        """Refresh monitor detection and restart processes"""
        self.stop()
        self._detect_monitors_accurate()
    
    def stop(self):
        """Stop all launched processes without hiding cleanup failures."""
        self.is_running = False
        for process in list(getattr(self, "processes", {}).values()):
            try:
                if process.poll() is None:
                    process.terminate()
                    process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                try:
                    process.kill()
                    process.wait(timeout=1)
                except (OSError, subprocess.TimeoutExpired) as exc:
                    logger.warning("Could not force-stop process %s: %s", getattr(process, "pid", "unknown"), exc)
            except (OSError, subprocess.SubprocessError) as exc:
                logger.warning("Could not stop process %s: %s", getattr(process, "pid", "unknown"), exc)
        getattr(self, "processes", {}).clear()
        logger.info("All processes stopped")

    def __del__(self):
        try:
            self.stop()
        except Exception:
            # Destructors can run after partial initialization or during shutdown.
            logger.debug("Ignoring cleanup failure during shutdown", exc_info=True)

# Convenience function
def get_monitor_manager(config_dir: Optional[str] = None) -> MultiMonitorManager:
    """Get or create the global monitor manager instance"""
    return MultiMonitorManager(config_dir)


# Example usage
if __name__ == "__main__":
    # Configure logging
    logging.basicConfig(level=logging.INFO)
    
    # Create manager
    manager = MultiMonitorManager()
    
    # Display all monitors
    manager.show_status()
    
    # Launch display windows on all non-primary monitors
    for i, mon in enumerate(manager.get_monitor_info()):
        if not mon.is_primary:
            print(f"Launching display on monitor {i}...")
            manager.launch_display_window(i)
    
    # Keep running
    try:
        import time
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\nStopping...")
        manager.stop()
